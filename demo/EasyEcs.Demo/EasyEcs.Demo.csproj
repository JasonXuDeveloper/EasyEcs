<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <!-- The live demo of the docs site (https://ecs.xgamedev.net/en/docs/demo): a world that runs in the browser on
         .NET's WebAssembly runtime. docs/scripts/build-demo.sh publishes it into docs/public/demo. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WasmEnableSIMD>true</WasmEnableSIMD>
        <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
        <!-- As small as the runtime gets: trimmed IL, no ICU, no globalization data, no debugger, no timezone
             data. -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <InvariantGlobalization>true</InvariantGlobalization>
        <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
        <DebuggerSupport>false</DebuggerSupport>
        <EventSourceSupport>false</EventSourceSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
        <!-- Cloudflare compresses on the fly; precompressed copies would only double the committed bundle. -->
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <!-- Published with Mono AOT, which needs the wasm-tools workload (docs/scripts/build-demo.sh installs it): the
         IL is compiled ahead of time to WebAssembly with 128-bit SIMD and native exception handling, and the
         compiled method bodies are stripped from the shipped assemblies. Only on publish, so building the solution
         needs no workload. -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    </PropertyGroup>

    <!-- With the NuGet package this is one line: <PackageReference Include="EasyEcs" Version="..."/> (the package
         carries the generator). A reference to the sources adds the generator as an analyzer itself. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
