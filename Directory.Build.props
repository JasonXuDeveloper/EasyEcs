<Project>
    <!-- Single source of the version: the package, EasyEcs.Core and the bundled EasyEcs.Generator all carry it.
         The Release workflow bumps it here. -->
    <PropertyGroup>
        <Version>4.7.0</Version>
    </PropertyGroup>

    <!-- What the package's build files set in the projects that reference it: the repository's projects reference
         EasyEcs.Core directly. -->
    <Import Project="$(MSBuildThisFileDirectory)src/EasyEcs.Core/build/EasyEcs.props"/>
</Project>
