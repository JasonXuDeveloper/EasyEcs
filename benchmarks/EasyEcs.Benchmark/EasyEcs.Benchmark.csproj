<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Benchmarks measure the generic and hand-written forms against the generated ones (EECS103: the hand-written
             vector loops of KernelBenchmark, StepBatch / StepBatch512 / Move2Cast / IntegrateBatch, are the baselines
             the generated loops are measured against); BattleServer.cs is kept clean by tests/EasyEcs.Aot (warnings as errors). -->
        <NoWarn>$(NoWarn);EECS033;EECS065;EECS067;EECS084;EECS103</NoWarn>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <Optimize>true</Optimize>
        <!-- [SkipLocalsInit] on the hand-written stencils of TileBenchmark: their stack textures are not cleared -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.2"/>
        <!-- GeneratorBenchmark drives the generators and the analyzer through Roslyn -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <ProjectReference Include="..\EasyEcs.Benchmark.Plugin\EasyEcs.Benchmark.Plugin.csproj"/>
        <!-- consumers of the NuGet package get the generator automatically; project references must add it (as a
             reference too: GeneratorBenchmark drives it directly) -->
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <!-- the battle server's source: part of the code GeneratorBenchmark compiles -->
        <EmbeddedResource Include="BattleServer.cs" LogicalName="BattleServer.cs"/>
    </ItemGroup>

</Project>
