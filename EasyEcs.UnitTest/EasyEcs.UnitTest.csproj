<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0"/>
        <!-- generator tests drive EasyEcs.Generator through Roslyn -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
        <!-- [NinoType] components in SerializationTests -->
        <PackageReference Include="Nino.Generator" Version="4.0.0-rc.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <!-- as analyzer: generates [ForEach] systems in this assembly; as reference: driven directly by GeneratorTests -->
        <ProjectReference Include="..\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <!-- the README's battle server, compiled unchanged (BattleServerTests) -->
        <Compile Include="..\EasyEcs.Benchmark\BattleServer.cs" Link="BattleServer.cs"/>
    </ItemGroup>

</Project>
