<Project Sdk="Microsoft.NET.Sdk">

    <!-- Compiles the C# fences of the docs (docs/content and README.md) against EasyEcs.Core with the generator and
         the analyzer: dotnet run, project tools/DocCheck (README.md has the conventions). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- the assembly the snippets compile against (its path is the metadata reference) -->
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <!-- referenced, not an analyzer: the checker drives SystemGenerator, ComponentGenerator and EasyEcsAnalyzer -->
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj"/>
    </ItemGroup>

</Project>
