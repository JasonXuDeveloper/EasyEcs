<Project Sdk="Microsoft.NET.Sdk">

    <!-- Runs benchmark methods past Tier1 so tools/loopbound.sh can read their loops' machine code. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\benchmarks\EasyEcs.Benchmark\EasyEcs.Benchmark.csproj"/>
    </ItemGroup>

</Project>
