<Project Sdk="Microsoft.NET.Sdk">

    <!-- Writes the API reference (docs/content/reference/*.mdx) from the public API of EasyEcs.Core and its XML docs:
         dotnet run, project tools/ApiDocs. CI regenerates it and fails when the committed pages differ. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- the documented assembly: its path and XML file are read as metadata -->
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
    </ItemGroup>

</Project>
