<Project Sdk="Microsoft.NET.Sdk">

    <!-- Reports every generated job a runner of the benchmark worlds failed to inline, with the JIT's reason:
         tools/perf/inlining.sh. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\benchmarks\EasyEcs.Benchmark\EasyEcs.Benchmark.csproj"/>
        <Compile Include="..\..\Shared\BenchmarkRunner.cs" Link="BenchmarkRunner.cs"/>
    </ItemGroup>

</Project>
