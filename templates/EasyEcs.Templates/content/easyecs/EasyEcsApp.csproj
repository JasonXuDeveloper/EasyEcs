<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- the package carries the generator ([ForEach] systems, generated members) and the analyzer -->
        <PackageReference Include="EasyEcs" Version="EASYECS_VERSION"/>
    </ItemGroup>
<!--#if (tests) -->

    <ItemGroup>
        <Compile Remove="EasyEcsApp.Tests\**"/>
    </ItemGroup>
<!--#endif -->

</Project>
