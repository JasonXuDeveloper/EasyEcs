<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Read by Native AOT only (dotnet publish -p:PublishAot=true): compile for the CPU of the machine that
             publishes, or the Vector512 tier of the generated vector loops is compiled out. A fleet names a level
             instead (x86-64-v3: AVX2, x86-64-v4: AVX-512). -->
        <IlcInstructionSet>native</IlcInstructionSet>
    </PropertyGroup>

    <ItemGroup>
        <!-- the package carries the generator ([ForEach] systems, generated members) and the analyzer -->
        <PackageReference Include="EasyEcs" Version="EASYECS_VERSION"/>
    </ItemGroup>
<!--#if (tests) -->

    <ItemGroup>
        <Compile Remove="EasyEcsApp.Tests\**"/>
    </ItemGroup>
<!--#endif -->

</Project>
