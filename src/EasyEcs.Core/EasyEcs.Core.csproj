<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The core calls the generic API it implements, and ChildOf's key is written before the generator runs on it. -->
        <NoWarn>$(NoWarn);EECS033;EECS067</NoWarn>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>preview</LangVersion>
        <!-- Archetype.Aligned: the address of a pinned column, to start its rows on a cache line -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- trimming and Native AOT analyzers run on every build: the library must stay reflection-free on hot paths -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- XML docs: IntelliSense in the package and the API reference (tools/ApiDocs); every public member has one -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>EasyEcs</PackageId>
        <Title>EasyEcs</Title>
        <Authors>JasonXuDeveloper</Authors>
        <Description>High-performance, allocation-free archetype Entity Component System (ECS) for C# and .NET 10, for anything that updates many entities every frame or tick: game servers, Godot 4 games, simulations, real-time backends. Faster than Friflo.Engine.ECS, Arch and DefaultEcs in most head-to-head benchmarks (saves, bulk changes, spawning, value queries, hierarchies, indexes, change tracking), with zero allocation per tick. Source-generated [ForEach] systems, immediate structural changes, safe parallel systems, change tracking, value indexes, relations, dynamic buffers, snapshots and saves; a Roslyn analyzer with code fixes. Native AOT ready.</Description>
        <Copyright>JasonXuDeveloper</Copyright>
        <PackageProjectUrl>https://ecs.xgamedev.net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/JasonXuDeveloper/EasyEcs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>ecs;entity-component-system;csharp;dotnet;archetype;data-oriented-design;game-server;gamedev;godot;simulation;high-performance;zero-allocation;source-generator;roslyn-analyzer;aot</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Source Link (built into the SDK) + a symbol package (.snupkg, pushed next to the .nupkg) for debugging -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- World.RowStats: tests check that tables are dense between passes -->
        <InternalsVisibleTo Include="EasyEcs.UnitTest" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <!-- InterceptorsNamespaces for lambda passes, in every project that references the package (directly or not) -->
        <None Include="build\EasyEcs.props" Pack="true" PackagePath="build;buildTransitive"/>
    </ItemGroup>

    <!-- World.Save / Load: Nino writes managed components and singletons ([NinoType]); unmanaged columns are raw rows.
         The Nino package brings Nino.Serialization and, through buildTransitive, Nino.Generator to every project that
         references EasyEcs, so [NinoType] components get their formatters with no other package. -->
    <ItemGroup>
        <PackageReference Include="Nino" Version="4.0.0-rc.7" />
    </ItemGroup>

    <!-- EasyEcs.Generator: expands the T1..T9 API inside this assembly and ships to consumers for [ForEach] systems -->
    <ItemGroup>
        <ProjectReference Include="..\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <None Include="..\EasyEcs.Generator\bin\$(Configuration)\netstandard2.0\EasyEcs.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <!-- EasyEcs.CodeFixes: ships beside the generator; IDEs load it with Workspaces, compilers never do -->
    <ItemGroup>
        <ProjectReference Include="..\EasyEcs.CodeFixes\EasyEcs.CodeFixes.csproj" ReferenceOutputAssembly="false"/>
        <None Include="..\EasyEcs.CodeFixes\bin\$(Configuration)\netstandard2.0\EasyEcs.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

</Project>
