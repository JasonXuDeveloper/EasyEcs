<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>preview</LangVersion>
        <!-- Archetype.Aligned: the address of a pinned column, to start its rows on a cache line -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>EasyEcs</PackageId>
        <Title>EasyEcs</Title>
        <Authors>JasonXuDeveloper</Authors>
        <Description>An Entity-Component-System library</Description>
        <Copyright>JasonXuDeveloper</Copyright>
        <PackageProjectUrl>https://github.com/JasonXuDeveloper/EasyEcs</PackageProjectUrl>
        <RepositoryUrl>https://github.com/JasonXuDeveloper/EasyEcs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>ECS</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Source Link (built into the SDK) + a symbol package (.snupkg, pushed next to the .nupkg) for debugging -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- EasyEcs.Generator: expands the T1..T9 API inside this assembly and ships to consumers for [Query] systems -->
    <ItemGroup>
        <ProjectReference Include="..\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <None Include="..\EasyEcs.Generator\bin\$(Configuration)\netstandard2.0\EasyEcs.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

</Project>
