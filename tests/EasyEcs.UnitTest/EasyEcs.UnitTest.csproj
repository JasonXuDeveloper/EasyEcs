<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- EECS069: fixtures hold references on purpose (SerializationTests asserts that a save of one throws). -->
        <!-- The tests exercise the generic API and hand-written parts the generated forms stand for (EECS033, EECS065,
             EECS067); EECS069: test components that are never saved. -->
        <NoWarn>$(NoWarn);EECS033;EECS065;EECS067;EECS069</NoWarn>
        <!-- the gathers and compressing stores of the linked locality prototypes take pointers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit3TestAdapter" Version="5.2.0"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0"/>
        <!-- generator tests drive EasyEcs.Generator through Roslyn -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
        <!-- code fix tests apply EasyEcs.CodeFixes in a workspace -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <!-- as analyzer: generates [ForEach] systems in this assembly; as reference: driven directly by GeneratorTests -->
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\EasyEcs.CodeFixes\EasyEcs.CodeFixes.csproj"/>
        <!-- a library's public generic system, closed here (GenericTests) -->
        <ProjectReference Include="..\EasyEcs.Aot.Library\EasyEcs.Aot.Library.csproj"/>
        <!-- the README's battle server, compiled unchanged (BattleServerTests) -->
        <Compile Include="..\..\benchmarks\EasyEcs.Benchmark\BattleServer.cs" Link="BattleServer.cs"/>
        <!-- the VoxelServer sample's world, its zombies and their scent (VoxelServerTests) -->
        <ProjectReference Include="..\..\samples\VoxelServer\VoxelServer.csproj"/>
        <!-- the phase 0 prototypes of docs/plans/locality.md, checked against their plain forms (LocalityTests) -->
        <Compile Include="..\..\benchmarks\EasyEcs.Benchmark\Locality\*.cs" LinkBase="Locality"/>
    </ItemGroup>

</Project>
