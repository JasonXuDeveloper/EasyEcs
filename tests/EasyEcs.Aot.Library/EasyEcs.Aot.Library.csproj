<Project Sdk="Microsoft.NET.Sdk">

    <!-- A library's public generic system that EasyEcs.Aot closes over a component of its own: the library cannot name
         the closed type, so the generator of EasyEcs.Aot registers its code (no runtime code generation under AOT). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
