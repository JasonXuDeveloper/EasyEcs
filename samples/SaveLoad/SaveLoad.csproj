<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- With the NuGet package this is one line: <PackageReference Include="EasyEcs" Version="..."/> (the package
         carries the generator). A reference to the sources adds the generator as an analyzer itself. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\EasyEcs.Core\EasyEcs.Core.csproj"/>
        <ProjectReference Include="..\..\src\EasyEcs.Generator\EasyEcs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- [NinoType] components: the formatters World.Save writes managed components with -->
    <ItemGroup>
        <PackageReference Include="Nino.Generator" Version="4.0.0-rc.6"/>
    </ItemGroup>

</Project>
